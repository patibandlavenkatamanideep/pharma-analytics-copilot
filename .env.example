# Copy to .env and fill in. NEVER commit .env.
# scripts/bootstrap_db.py generates the database passwords for you.

# --- database ---
PAC_DB_HOST=127.0.0.1
PAC_DB_PORT=5432
PAC_DB_NAME=pharma_analytics
PAC_DB_OWNER_USER=pac_owner
PAC_DB_AUTH_USER=pac_auth_login
PAC_DB_EXEC_USER=pac_exec_login
PAC_DB_SCOPED_USER=pac_scoped_login
PAC_DB_OWNER_PASSWORD=
PAC_DB_AUTH_PASSWORD=
PAC_DB_EXEC_PASSWORD=
PAC_DB_SCOPED_PASSWORD=

# Only needed by compose, to create the cluster superuser.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# --- language model ---
# offline = deterministic keyword planner, no credentials, no spend.
# bedrock = AWS Bedrock. Requires working AWS credentials AND Anthropic
#           use-case details submitted for the account.
PAC_LLM_PROVIDER=offline
PAC_BEDROCK_REGION=us-east-1
# Dated models need an inference profile prefix (us. or global.).
PAC_BEDROCK_MODEL_ID=us.anthropic.claude-opus-4-5-20251101-v1:0
PAC_LLM_EFFORT=low

# --- execution limits ---
PAC_STATEMENT_TIMEOUT_MS=5000
PAC_MAX_RESULT_ROWS=5000

# --- sessions ---
PAC_SESSION_TTL_HOURS=12
# Set false ONLY for local HTTP. Must be true behind HTTPS.
PAC_COOKIE_SECURE=true
